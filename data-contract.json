{"$id": "beachsolo-agent-kit/data-contract@1", "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "BeachSOLO Attempt Full Bundle", "description": "BeachSOLO 单次答题完整数据包契约（schemaVersion=1）。由服务端 /api/data-export/admin/attempts/:attemptId/bundle 打包，用户手动下载后附发给 Agent。", "type": "object", "required": ["schemaVersion", "attemptId", "userId", "exportedAt", "paper", "snapshot", "questionsFull", "answersRaw", "starterAnswers", "behaviorEventsRaw"], "properties": {"schemaVersion": {"type": "integer", "const": 1, "description": "数据包契约版本，当前固定为 1"}, "attemptId": {"type": "string", "description": "本次答题唯一 ID（幂等键，用于步骤 0 去重）"}, "userId": {"type": "string", "description": "答题用户 ID（BeachSOLO 内部标识）"}, "exportedAt": {"type": "string", "format": "date-time", "description": "数据包导出时刻（ISO 8601）"}, "paper": {"$ref": "#/$defs/AttemptFullBundlePaper"}, "snapshot": {"$ref": "#/$defs/AttemptSnapshotPayload"}, "questionsFull": {"type": "array", "items": {"$ref": "#/$defs/FullQuestionRecord"}, "description": "每题完整内容（与 snapshot.questions 按 questionId 同序关联）"}, "answersRaw": {"type": "array", "items": {"$ref": "#/$defs/RawAnswerRecord"}, "description": "每题原始作答记录（服务端权威落库）"}, "starterAnswers": {"type": "array", "items": {"$ref": "#/$defs/RawStarterAnswerRecord"}, "description": "开场阅卷期选择记录（无开场阅卷时为空数组）"}, "behaviorEventsRaw": {"type": "array", "items": {"$ref": "#/$defs/RawEventRecord"}, "description": "逐条原始行为事件流"}}, "$defs": {"AttemptFullBundlePaper": {"type": "object", "required": ["title", "origin"], "properties": {"title": {"type": "string"}, "examType": {"type": ["string", "null"], "description": "考试类别（如行测、申论）"}, "year": {"type": ["integer", "null"]}, "region": {"type": ["string", "null"]}, "paperType": {"type": ["string", "null"]}, "durationMinutes": {"type": ["integer", "null"]}, "totalScore": {"type": ["number", "null"]}, "origin": {"type": "string", "enum": ["system", "user", "unknown"], "description": "system=内置题库 / user=用户导入 / unknown=已删除或无法溯源"}}}, "AttemptSnapshotPayload": {"type": "object", "required": ["meta", "questions", "behavior", "mistakes", "dataDictionary"], "properties": {"meta": {"$ref": "#/$defs/SnapshotMeta"}, "questions": {"type": "array", "items": {"$ref": "#/$defs/SnapshotQuestion"}}, "behavior": {"$ref": "#/$defs/SnapshotBehavior"}, "mistakes": {"type": "array", "items": {"$ref": "#/$defs/SnapshotMistake"}}, "dataDictionary": {"type": "object", "additionalProperties": {"type": "string"}, "description": "内嵌字段口径说明，Agent 必须先读此字典再解读数据"}}}, "SnapshotMeta": {"type": "object", "required": ["attemptId", "paperTitle", "examMode", "durationSeconds", "score", "totalScore", "correctCount", "wrongCount", "unansweredCount"], "properties": {"attemptId": {"type": "string"}, "paperTitle": {"type": "string"}, "examMode": {"type": "string", "description": "full_simulation=整卷真题模拟；其它见 attempts.exam_mode"}, "submittedAt": {"type": ["string", "null"], "format": "date-time"}, "startedAt": {"type": ["string", "null"], "format": "date-time"}, "durationSeconds": {"type": "number"}, "score": {"type": "number"}, "totalScore": {"type": "number"}, "correctCount": {"type": "integer"}, "wrongCount": {"type": "integer"}, "unansweredCount": {"type": "integer"}}}, "SnapshotQuestion": {"type": "object", "required": ["questionNo", "questionId", "section", "subsection", "status", "elapsedSeconds"], "properties": {"questionNo": {"type": "integer"}, "questionId": {"type": "string"}, "section": {"type": "string", "description": "模块（如言语理解、数量关系、判断推理、资料分析、常识判断）"}, "subsection": {"type": "string", "description": "子模块"}, "status": {"type": "string", "enum": ["correct", "wrong", "unanswered", "changedToRight", "changedToWrong"], "description": "五态：correct=答对；wrong=答错；unanswered=未答；changedToRight=改答后终答正确；changedToWrong=改答后终答错误"}, "finalAnswer": {"type": ["string", "null"]}, "firstAnswer": {"type": ["string", "null"], "description": "行为事件流首条决策事件的取值；旧数据无事件流时为 null"}, "changeCount": {"type": "integer", "description": "服务端权威重算的改答次数（含卷面草稿决策链）"}, "changedDirection": {"type": ["string", "null"], "enum": ["changed_to_right", "changed_to_wrong", null]}, "elapsedSeconds": {"type": "number", "description": "行为事件流时差归因用时（扣暂停、600s 闲置截断）"}, "marked": {"type": "boolean", "description": "用户自报标记待复查"}, "uncertain": {"type": "boolean", "description": "用户自报标记不确定"}, "draftMatchesFinal": {"type": ["boolean", "null"], "description": "卷面草稿与答题卡终值是否一致；无草稿时为 null"}, "firstAnsweredAt": {"type": ["string", "null"], "format": "date-time"}, "lastChangedAt": {"type": ["string", "null"], "format": "date-time"}}}, "SnapshotBehavior": {"type": "object", "required": ["pauseCount", "pauseTotalSeconds", "eventCount"], "properties": {"pauseCount": {"type": "integer"}, "pauseTotalSeconds": {"type": "number"}, "eventCount": {"type": "integer"}, "starterPhaseDurationSeconds": {"type": ["number", "null"], "description": "开场阅卷期时长（秒），未启用时为 null"}}}, "SnapshotMistake": {"type": "object", "required": ["questionId", "wrongCount"], "properties": {"questionId": {"type": "string"}, "wrongCount": {"type": "integer", "description": "累计做错次数"}, "consecutiveCorrect": {"type": "integer", "description": "连续答对次数"}, "practiceCount": {"type": "integer", "description": "错题重练次数"}, "userReasons": {"type": "array", "items": {"$ref": "#/$defs/SnapshotMistakeReason"}, "description": "用户自打错因标签"}, "status": {"type": "string", "description": "active=在册 / removed=已移出错题本"}}}, "SnapshotMistakeReason": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "description": "concept=概念不清 / careless=粗心大意 / method=方法不当 / time=时间不足 / hesitation=犹豫改错 / other=其他"}, "note": {"type": ["string", "null"]}, "createdAt": {"type": ["string", "null"], "format": "date-time"}}}, "FullQuestionRecord": {"type": "object", "required": ["questionNo", "questionId", "section", "subsection"], "properties": {"questionNo": {"type": "integer"}, "questionId": {"type": "string"}, "section": {"type": "string"}, "subsection": {"type": "string"}, "stem": {"type": ["string", "null"], "description": "题干纯文本"}, "stemRich": {"type": ["string", "null"], "description": "题干富文本（含内联图片标记）"}, "material": {"type": ["string", "null"], "description": "共享材料（资料分析/阅读理解共用）"}, "materialRich": {"type": ["string", "null"]}, "materialGroupId": {"type": ["string", "null"]}, "options": {"type": "object", "additionalProperties": {"type": ["string", "null"]}, "description": "选项键值（A-H，无该选项为 null）"}, "answer": {"type": ["string", "null"], "description": "标准答案字母（单选）"}, "correctOptions": {"type": ["string", "null"], "description": "多选正确项（逗号分隔）"}, "answerMode": {"type": ["string", "null"]}, "analysis": {"type": ["string", "null"], "description": "解析纯文本"}, "analysisRich": {"type": ["string", "null"], "description": "解析富文本"}, "stemImageUrls": {"type": ["string", "null"], "description": "题干配图路径（BeachSOLO 内部，外部不可访问）"}, "materialImageUrls": {"type": ["string", "null"]}, "optionImageUrls": {"type": ["string", "null"]}, "source": {"type": ["string", "null"]}, "score": {"type": ["string", "null"]}}}, "RawAnswerRecord": {"type": "object", "required": ["questionId"], "properties": {"questionId": {"type": "string"}, "selectedAnswer": {"type": ["string", "null"], "description": "终答（多选用逗号分隔）"}, "firstAnswer": {"type": ["string", "null"]}, "draftAnswer": {"type": ["string", "null"], "description": "卷面草稿选择"}, "starterAnswer": {"type": ["string", "null"], "description": "开场阅卷期选择"}, "finalAnswer": {"type": ["string", "null"]}, "phase": {"type": "string", "description": "作答阶段"}, "isChanged": {"type": "boolean", "description": "终答与首答是否不同"}, "changeCount": {"type": "integer"}, "changedTimes": {"type": "integer"}, "marked": {"type": "boolean"}, "uncertain": {"type": "boolean"}, "elapsedSeconds": {"type": "number"}, "firstAnsweredAt": {"type": ["string", "null"], "format": "date-time"}, "lastChangedAt": {"type": ["string", "null"], "format": "date-time"}}}, "RawStarterAnswerRecord": {"type": "object", "required": ["questionId", "selectedOption", "selectedAt"], "properties": {"questionId": {"type": "string"}, "selectedOption": {"type": "string"}, "selectedAt": {"type": "string", "format": "date-time"}, "changedAt": {"type": ["string", "null"], "format": "date-time"}}}, "RawEventRecord": {"type": "object", "required": ["type", "occurredAt"], "properties": {"attemptId": {"type": ["string", "null"]}, "type": {"type": "string", "description": "事件类型：draft/changeDraft（卷面通道）、fill/changeAnswer/unfill/answer（答题卡通道）、pause/resume（暂停恢复）等"}, "occurredAt": {"type": "string", "format": "date-time", "description": "业务墙钟时刻"}, "elapsedSeconds": {"type": ["number", "null"], "description": "客户端累计秒"}, "questionId": {"type": ["string", "null"]}, "value": {"type": ["string", "null"]}, "metadata": {"type": ["object", "null"], "additionalProperties": true}}}}}